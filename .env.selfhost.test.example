# Public, disposable values for an isolated local rehearsal only.
J2M_ENV_FILE=.env.selfhost.test.example
J2M_IMAGE=j2m-interactive:local-test
J2M_LOCAL_PORT=8000
FLASK_ENV=development
FLASK_DEBUG=false
SECRET_KEY=local-isolated-session-key-0123456789-abcdef
JWT_SECRET_KEY=local-isolated-jwt-key-abcdef-0123456789
REGISTRATION_IDENTITY_HMAC_KEY=local-isolated-identity-key-0123456789-abcdef
REFERRAL_EVIDENCE_HMAC_KEYS=local-isolated-referral-key-0123456789-abcdef
REGISTRATION_EMAIL_ENCRYPTION_KEY=local-isolated-email-key-0123456789-abcdef
DATABASE_URL=postgresql://j2m_test:j2m-isolated-test-only@postgres-test:5432/j2m_test
DATABASE_SSLMODE=disable
PUBLIC_BASE_URL=http://127.0.0.1:8000
CORS_ORIGINS=http://127.0.0.1:8000
SESSION_COOKIE_SECURE=false
TRUSTED_PROXY_COUNT=0
UPLOAD_STORAGE_BACKEND=disabled
RECOVERY_MAIL_BACKEND=memory
GOOGLE_WALLET_MODE=disabled
APPLE_WALLET_MODE=disabled
