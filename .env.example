# Flask Configuration
FLASK_APP=run.py
FLASK_ENV=development
FLASK_DEBUG=True
SECRET_KEY=change-this-secret-key-in-production-j2m-loyalty

# Database Configuration
# Default to SQLite for local development:
DATABASE_URL=sqlite:///j2m_loyalty.db
# PostgreSQL for staging/production:
# DATABASE_URL=postgresql://postgres:password@localhost:5432/j2m_loyalty_db

# CORS Configuration
CORS_ORIGINS=*

# JWT Configuration
JWT_SECRET_KEY=change-jwt-secret-key-in-production
JWT_ACCESS_TOKEN_EXPIRES=86400

# Server
PORT=5000
HOST=0.0.0.0
