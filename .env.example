# Flask Configuration
FLASK_APP=run.py
FLASK_ENV=development
FLASK_DEBUG=True
SECRET_KEY=change-this-secret-key-in-production-j2m-loyalty

# Database Configuration
# Default to SQLite for local development:
DATABASE_URL=sqlite:///j2m_loyalty.db
# PostgreSQL for staging/production:
# Use the private Railway variable with the Supabase Session pooler URL.
# Keep sslmode=require in the URL or use DATABASE_SSLMODE=require.
# DATABASE_URL=postgresql://postgres.PROJECT_REF:REDACTED@POOLER_HOST:5432/postgres?sslmode=require
DATABASE_SSLMODE=require
DATABASE_POOL_SIZE=3
DATABASE_MAX_OVERFLOW=2
DATABASE_POOL_TIMEOUT=30
DATABASE_POOL_RECYCLE=300
DATABASE_CONNECT_TIMEOUT=10

# CORS Configuration
CORS_ORIGINS=http://127.0.0.1:5000

# JWT Configuration
JWT_SECRET_KEY=change-for-an-independent-random-secret-of-at-least-32-characters
JWT_ACCESS_TOKEN_EXPIRES=900
JWT_REFRESH_TOKEN_EXPIRES=2592000
JWT_ISSUER=j2m-interactive
JWT_AUDIENCE=j2m-staff
AUTH_RATE_LIMIT_ATTEMPTS=5
AUTH_RATE_LIMIT_WINDOW=300
# Número exacto de proxies inversos controlados delante de Flask. Use 0 sin proxy.
TRUSTED_PROXY_COUNT=0
LOG_REQUESTS=true
MAX_TRANSACTION_AMOUNT=1000000
WALLET_TOKEN_MAX_AGE=900

# Recuperación verificada de clientes (SMTP seguro)
RECOVERY_CODE_MAX_AGE=600
RECOVERY_SESSION_MAX_AGE=900
RECOVERY_MAX_ATTEMPTS=5
RECOVERY_REQUEST_LIMIT_EMAIL=3
RECOVERY_REQUEST_LIMIT_IP=10
RECOVERY_RATE_WINDOW=900
RECOVERY_CHALLENGE_RETENTION=86400
# Registro directo sin correo. La clave de identidad debe ser independiente y estable.
REGISTRATION_IDENTITY_HMAC_KEY=replace-with-an-independent-stable-random-key-of-at-least-32-characters
# Límites del alta directa por teléfono e IP.
REGISTRATION_REQUEST_LIMIT_PHONE=3
REGISTRATION_REQUEST_LIMIT_IP=10
REGISTRATION_RATE_WINDOW=900
WALLET_DELIVERY_MAX_AGE=900
# Configuración histórica de correo conservada mientras existan filas antiguas
# del outbox. El alta pública y la recuperación no la utilizan.
REGISTRATION_EMAIL_ENCRYPTION_KEY=replace-with-an-independent-stable-random-key-of-at-least-32-characters
REGISTRATION_EMAIL_POLL_SECONDS=5
REGISTRATION_EMAIL_BATCH_SIZE=50
REGISTRATION_EMAIL_MAX_ATTEMPTS=5
REGISTRATION_EMAIL_STALE_SECONDS=300
REGISTRATION_EMAIL_RETENTION_SECONDS=604800
RECOVERY_MAIL_BACKEND=smtp
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=no-reply@tu-dominio.example
SMTP_USE_TLS=false

# Google Wallet Configuration (Service Account & Issuer ID)
GOOGLE_WALLET_MODE=mock
GOOGLE_ISSUER_ID=3388000000000000000
# Store the complete JSON only in the platform's private variable store.
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_WALLET_SYNC_POLL_SECONDS=10
GOOGLE_WALLET_SYNC_BATCH_SIZE=50
GOOGLE_WALLET_SYNC_ALERT_PENDING=100
GOOGLE_WALLET_SYNC_ALERT_STALE_SECONDS=300

# Apple Wallet Configuration
APPLE_PASS_TYPE_ID=pass.com.j2minteractive.loyalty
APPLE_TEAM_ID=ABCDE12345
APPLE_CERT_PATH=certs/passcert.pem
APPLE_KEY_PATH=certs/passkey.pem
APPLE_KEY_PASSWORD=tu_clave_opcional
APPLE_WWDR_PATH=certs/wwdr.pem
APPLE_WEB_SERVICE_URL=https://api.j2minteractive.com/api/apple/v1

# Server
PORT=5000
HOST=0.0.0.0
# Cookies de sesión administrativa (true en producción con HTTPS)
SESSION_COOKIE_SECURE=false
# Límite total de solicitudes con archivos (bytes; predeterminado 12 MB)
# Permite dos imágenes de 5 MB más el overhead multipart
MAX_CONTENT_LENGTH=12582912
# URL pública HTTPS usada por Google Wallet para archivos locales
PUBLIC_BASE_URL=https://tu-dominio.example
# Railway uses an ephemeral filesystem. Keep disabled until a persistent
# storage adapter is implemented and tested. Local is only for development.
UPLOAD_STORAGE_BACKEND=local
