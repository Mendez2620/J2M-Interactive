# Copy to .env.selfhost outside Git and replace every REQUIRED value.
J2M_ENV_FILE=.env.selfhost
J2M_IMAGE=j2m-interactive:approved
J2M_LOCAL_PORT=8000
CLOUDFLARED_METRICS_PORT=2000
J2M_CLOUDFLARED_ENV_FILE=.env.cloudflared

FLASK_ENV=production
FLASK_DEBUG=false
SECRET_KEY=REQUIRED
JWT_SECRET_KEY=REQUIRED
REGISTRATION_IDENTITY_HMAC_KEY=REQUIRED
REFERRAL_EVIDENCE_HMAC_KEYS=REQUIRED
REGISTRATION_EMAIL_ENCRYPTION_KEY=REQUIRED

# Keep the Supabase Session pooler URL private and require TLS.
DATABASE_URL=REQUIRED
DATABASE_SSL_ROOT_CERT=REQUIRED_LOCAL_CERT_PATH
DATABASE_SSLMODE=require
DATABASE_POOL_SIZE=3
DATABASE_MAX_OVERFLOW=2
DATABASE_POOL_TIMEOUT=30
DATABASE_POOL_RECYCLE=300
DATABASE_CONNECT_TIMEOUT=10

PUBLIC_BASE_URL=REQUIRED_HTTPS_ORIGIN
CORS_ORIGINS=REQUIRED_HTTPS_ORIGIN
WEBAUTHN_ORIGIN=REQUIRED_HTTPS_ORIGIN
WEBAUTHN_RP_ID=REQUIRED_HOSTNAME
SESSION_COOKIE_SECURE=true
TRUSTED_PROXY_COUNT=1
UPLOAD_STORAGE_BACKEND=disabled
RECOVERY_MAIL_BACKEND=smtp
SMTP_HOST=REQUIRED
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=REQUIRED
SMTP_USE_TLS=true

# Keep both providers disabled for the first isolated/local cutover rehearsal.
GOOGLE_WALLET_MODE=disabled
APPLE_WALLET_MODE=disabled
