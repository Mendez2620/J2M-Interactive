# Public, synthetic values for the isolated production-mode rehearsal only.
J2M_ENV_FILE=.env.selfhost.production-test.example
J2M_IMAGE=j2m-interactive:local-production-test
J2M_LOCAL_PORT=18080
FLASK_ENV=production
FLASK_DEBUG=false
SECRET_KEY=synthetic-production-session-key-0123456789abcdef
JWT_SECRET_KEY=synthetic-production-jwt-key-fedcba9876543210
REGISTRATION_IDENTITY_HMAC_KEY=synthetic-production-identity-key-0123456789abcdef
REFERRAL_EVIDENCE_HMAC_KEYS=synthetic-production-referral-key-0123456789abcdef
REGISTRATION_EMAIL_ENCRYPTION_KEY=synthetic-production-email-key-0123456789abcdef
DATABASE_URL=postgresql://j2m_test:j2m-isolated-test-only@postgres-test:5432/j2m_test
DATABASE_SSLMODE=require
PUBLIC_BASE_URL=https://j2m.local.test
CORS_ORIGINS=https://j2m.local.test
WEBAUTHN_ORIGIN=https://j2m.local.test
WEBAUTHN_RP_ID=j2m.local.test
SESSION_COOKIE_SECURE=true
TRUSTED_PROXY_COUNT=0
UPLOAD_STORAGE_BACKEND=disabled
RECOVERY_MAIL_BACKEND=memory
GOOGLE_WALLET_MODE=disabled
APPLE_WALLET_MODE=disabled
